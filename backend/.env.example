# PostgreSQL connection
DATABASE_URL="postgresql://admin:password@localhost:5438/nexus_db?schema=public"
# Direct connection (same as DATABASE_URL if not using a connection pooler)
DIRECT_URL="postgresql://admin:password@localhost:5438/nexus_db?schema=public"
# REQUIRED - JWT signing key. App will fail to start without this.
JWT_SECRET="change-me-in-production"
CORS_ORIGIN="http://localhost:4200"
PORT=3000
# Set to "true" to seed demo data on startup (production only, via entrypoint.sh)
SEED_DATABASE="false"
